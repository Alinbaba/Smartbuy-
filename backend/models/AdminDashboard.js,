// ======================================================
// SmartBuy Enterprise Admin Dashboard Model
// ======================================================

const mongoose = require("mongoose");

const adminDashboardSchema = new mongoose.Schema({

    // ==================================================
    // Dashboard Owner
    // ==================================================

    admin: {
        type: mongoose.Schema.Types.ObjectId,
        ref: "User",
        required: true
    },

    // ==================================================
    // Dashboard Type
    // ==================================================

    dashboardType: {
        type: String,
        enum: [
            "super-admin",
            "finance-admin",
            "customer-care",
            "advertising-admin",
            "security-admin",
            "logistics-admin",
            "warehouse-admin",
            "vendor-manager",
            "ai-admin"
        ],
        required: true
    },

    // ==================================================
    // Dashboard Status
    // ==================================================

    status: {
        type: String,
        enum: [
            "active",
            "inactive"
        ],
        default: "active"
    },

    // ==================================================
    // Statistics
    // ==================================================

    totalUsers: {
        type: Number,
        default: 0
    },

    totalCustomers: {
        type: Number,
        default: 0
    },

    totalSellers: {
        type: Number,
        default: 0
    },

    totalOrders: {
        type: Number,
        default: 0
    },

    totalProducts: {
        type: Number,
        default: 0
    },

    totalCategories: {
        type: Number,
        default: 0
    },

    totalRevenue: {
        type: Number,
        default: 0
    },

    totalWithdrawals: {
        type: Number,
        default: 0
    },

    totalPendingOrders: {
        type: Number,
        default: 0
    },

    totalCompletedOrders: {
        type: Number,
        default: 0
    },

    // ==================================================
    // Recent Login
    // ==================================================

    lastAccess: {
        type: Date,
        default: Date.now
    },

    lastIP: {
        type: String,
        default: ""
    },

    // ==================================================
    // Dashboard Settings
    // ==================================================

    darkMode: {
        type: Boolean,
        default: false
    },

    language: {
        type: String,
        default: "English"
    },

    currency: {
        type: String,
        default: "NGN"
    },

    // ==================================================
    // Notes
    // ==================================================

    notes: {
        type: String,
        default: ""
    },

// ==================================================
// Dashboard Widgets
// ==================================================

dashboardWidgets: [{

    // Widget Name
    widget: {
        type: String,
        enum: [
            "sales",
            "orders",
            "revenue",
            "customers",
            "products",
            "inventory",
            "withdrawals",
            "wallet",
            "vendors",
            "kyc",
            "support",
            "shipments",
            "returns",
            "reviews",
            "notifications",
            "analytics"
        ]
    },

    // Show/Hide Widget
    enabled: {
        type: Boolean,
        default: true
    },

    // Position on Dashboard
    position: {
        type: Number,
        default: 0
    }

}],

// ==================================================
// Dashboard Filters
// ==================================================

defaultDateRange: {
    type: String,
    enum: [
        "today",
        "7days",
        "30days",
        "90days",
        "1year",
        "custom"
    ],
    default: "30days"
},

// ==================================================
// Dashboard Theme
// ==================================================

dashboardTheme: {
    type: String,
    enum: [
        "light",
        "dark",
        "system"
    ],
    default: "system"
},


// ======================================================
// Admin Activity Logs
// ======================================================

activityLogs: [

{
    admin: {
        type: mongoose.Schema.Types.ObjectId,
        ref: "User"
    },

    action: {
        type: String,
        default: ""
    },

    module: {
        type: String,
        default: ""
    },

    description: {
        type: String,
        default: ""
    },

    ipAddress: {
        type: String,
        default: ""
    },

    device: {
        type: String,
        default: ""
    },

    browser: {
        type: String,
        default: ""
    },

    status: {
        type: String,
        enum: [
            "success",
            "failed",
            "warning"
        ],
        default: "success"
    },

    createdAt: {
        type: Date,
        default: Date.now
    }

}
],

//======================================================
// Dashboard Statistics
// ======================================================

statistics: {

    // ==================================================
    // User Statistics
    // ==================================================

    totalUsers: {
        type: Number,
        default: 0
    },

    totalCustomers: {
        type: Number,
        default: 0
    },

    totalSellers: {
        type: Number,
        default: 0
    },

    totalAdmins: {
        type: Number,
        default: 0
    },

    // ==================================================
    // Product Statistics
    // ==================================================

    totalProducts: {
        type: Number,
        default: 0
    },

    totalCategories: {
        type: Number,
        default: 0
    },

    totalBrands: {
        type: Number,
        default: 0
    },

    // ==================================================
    // Order Statistics
    // ==================================================

    totalOrders: {
        type: Number,
        default: 0
    },

    pendingOrders: {
        type: Number,
        default: 0
    },

    processingOrders: {
        type: Number,
        default: 0
    },

    shippedOrders: {
        type: Number,
        default: 0
    },

    deliveredOrders: {
        type: Number,
        default: 0
    },

    cancelledOrders: {
        type: Number,
        default: 0
    },

    // ==================================================
    // Financial Statistics
    // ==================================================

    totalRevenue: {
        type: Number,
        default: 0
    },

    totalTransactions: {
        type: Number,
        default: 0
    },

    totalWithdrawals: {
        type: Number,
        default: 0
    }

},

// ======================================================
// Recent Activities
// ======================================================

recentActivities: [

{

    title: {
        type: String,
        default: ""
    },

    description: {
        type: String,
        default: ""
    },

    module: {
        type: String,
        default: ""
    },

    actionType: {
        type: String,
        enum: [
            "create",
            "update",
            "delete",
            "approve",
            "reject",
            "login",
            "logout",
            "other"
        ],
        default: "other"
    },

    performedBy: {
        type: mongoose.Schema.Types.ObjectId,
        ref: "User",
        default: null
    },

    createdAt: {
        type: Date,
        default: Date.now
    }

}

],
// ======================================================
// Dashboard Notifications
// ======================================================

notifications: [

{

    // ===============================================
    // Notification Title
    // ===============================================

    title: {
        type: String,
        required: true,
        trim: true
    },

    // ===============================================
    // Notification Message
    // ===============================================

    message: {
        type: String,
        required: true,
        trim: true
    },

    // ===============================================
    // Notification Type
    // ===============================================

    type: {
        type: String,
        enum: [
            "info",
            "success",
            "warning",
            "error"
        ],
        default: "info"
    },

    // ===============================================
    // Notification Status
    // ===============================================

    isRead: {
        type: Boolean,
        default: false
    },

    // ===============================================
    // Notification Date
    // ===============================================

    createdAt: {
        type: Date,
        default: Date.now
    }

}

],

// ======================================================
// Quick Actions
// ======================================================

quickActions: [

{

    // ===============================================
    // Action Name
    // ===============================================

    name: {
        type: String,
        required: true,
        trim: true
    },

    // ===============================================
    // Icon
    // ===============================================

    icon: {
        type: String,
        default: ""
    },

    // ===============================================
    // Route
    // ===============================================

    route: {
        type: String,
        default: ""
    },

    // ===============================================
    // Display Order
    // ===============================================

    order: {
        type: Number,
        default: 0
    },

    // ===============================================
    // Visibility
    // ===============================================

    enabled: {
        type: Boolean,
        default: true
    }

}

],

// ======================================================
// Favorite Shortcuts
// ======================================================

favoriteShortcuts: [

{

    // ===============================================
    // Shortcut Name
    // ===============================================

    name: {
        type: String,
        required: true,
        trim: true
    },

    // ===============================================
    // Shortcut Route
    // ===============================================

    route: {
        type: String,
        required: true,
        trim: true
    },

    // ===============================================
    // Shortcut Icon
    // ===============================================

    icon: {
        type: String,
        default: ""
    },

    // ===============================================
    // Pinned Status
    // ===============================================

    pinned: {
        type: Boolean,
        default: true
    }

}

],

// ======================================================
// Pinned Reports
// ======================================================

pinnedReports: [

{

    // ===============================================
    // Report Name
    // ===============================================

    name: {
        type: String,
        required: true,
        trim: true
    },

    // ===============================================
    // Report Type
    // ===============================================

    reportType: {
        type: String,
        enum: [
            "sales",
            "finance",
            "orders",
            "customers",
            "vendors",
            "inventory",
            "shipping",
            "products",
            "security",
            "analytics"
        ],
        required: true
    },

    // ===============================================
    // Report Route
    // ===============================================

    route: {
        type: String,
        default: ""
    },

    // ===============================================
    // Last Viewed
    // ===============================================

    lastViewed: {
        type: Date,
        default: Date.now
    }

}

],

// ======================================================
// Dashboard Preferences
// ======================================================

preferences: {

    // ===============================================
    // Default Landing Page
    // ===============================================

    defaultPage: {
        type: String,
        default: "/admin/dashboard"
    },

    // ===============================================
    // Sidebar State
    // ===============================================

    sidebarCollapsed: {
        type: Boolean,
        default: false
    },

    // ===============================================
    // Show Welcome Message
    // ===============================================

    showWelcomeMessage: {
        type: Boolean,
        default: true
    },

    // ===============================================
    // Refresh Dashboard Automatically
    // ===============================================

    autoRefresh: {
        type: Boolean,
        default: true
    },

    // ===============================================
    // Refresh Interval (Seconds)
    // ===============================================

    refreshInterval: {
        type: Number,
        default: 60
    }

},

// ======================================================
// System Health
// ======================================================

systemHealth: {

    // ===============================================
    // API Status
    // ===============================================

    apiStatus: {
        type: String,
        enum: [
            "online",
            "offline",
            "maintenance"
        ],
        default: "online"
    },

    // ===============================================
    // Database Status
    // ===============================================

    databaseStatus: {
        type: String,
        enum: [
            "connected",
            "disconnected"
        ],
        default: "connected"
    },

    // ===============================================
    // Payment Gateway Status
    // ===============================================

    paymentGatewayStatus: {
        type: String,
        enum: [
            "online",
            "offline"
        ],
        default: "online"
    },

    // ===============================================
    // Storage Status
    // ===============================================

    storageStatus: {
        type: String,
        enum: [
            "healthy",
            "warning",
            "critical"
        ],
        default: "healthy"
    },

    // ===============================================
    // Last Health Check
    // ===============================================

    lastChecked: {
        type: Date,
        default: Date.now
    }

},
// ======================================================
// AI Dashboard Settings
// ======================================================

aiSettings: {

    // ===============================================
    // Enable AI Assistant
    // ===============================================

    enabled: {
        type: Boolean,
        default: true
    },

    // ===============================================
    // AI Suggestions
    // ===============================================

    showSuggestions: {
        type: Boolean,
        default: true
    },

    // ===============================================
    // AI Alerts
    // ===============================================

    showAlerts: {
        type: Boolean,
        default: true
    },

    // ===============================================
    // AI Sales Predictions
    // ===============================================

    salesPrediction: {
        type: Boolean,
        default: true
    },

    // ===============================================
    // AI Inventory Monitoring
    // ===============================================

    inventoryMonitoring: {
        type: Boolean,
        default: true
    },

    // ===============================================
    // AI Fraud Detection
    // ===============================================

    fraudDetection: {
        type: Boolean,
        default: true
    }
},


}, {

    timestamps: true

});

module.exports = mongoose.model(
    "AdminDashboard",
    adminDashboardSchema
);
